{
  "name": "deskicons",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "npm run typecheck && npm run build:server && vite build",
    "test": "node --test tests/*.test.js",
    "pack": "node scripts/package.js",
    "build:server": "node scripts/build-backend.js",
    "pretest": "npm run build:server && npm run build:test-web",
    "prestart": "npm run build:server",
    "predev": "npm run build:server",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "lint": "eslint backend web scripts tests *.js",
    "format": "prettier --write \"backend/**/*.ts\" \"web/**/*.{ts,tsx,css,html}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"backend/**/*.ts\" \"web/**/*.{ts,tsx,css,html}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.{js,json}\"",
    "lock:runtime": "node scripts/lock-runtime.js",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "npm run audit:frontend && tsc -p tsconfig.web.json",
    "build:test-web": "node scripts/build-test-web.js",
    "audit:frontend": "node scripts/audit-frontend-contracts.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@douyinfe/semi-ui": "^2.104.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@novnc/novnc": "1.7.0",
    "@trimjs/web-app": "latest",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-tinyh264": "2.1.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "@yume-chan/stream-extra": "2.6.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "codemirror": "^6.0.2",
    "dompurify": "3.4.17",
    "express": "^5.1.0",
    "iconv-lite": "^0.7.3",
    "marked": "18.1.1",
    "nodemailer": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "ssh2": "1.17.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/guacamole-common-js": "^1.5.5",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.2",
    "@types/novnc__novnc": "^1.6.0",
    "@types/prop-types": "15.7.12",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "esbuild": "0.25.12",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^6.1.0"
  }
}
